{
  "name": "fehm",
  "version": "0.1.0",
  "description": "Local-first codebase understanding, context engine and skill router for AI coding agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fehm": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "skills",
    "assets/ontology",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "bench": "node --import tsx bench/run.ts",
    "start": "node dist/cli.js",
    "bench:skills": "node --import tsx bench/skills.ts"
  },
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirhamzakhan2001/fehm.git"
  },
  "dependencies": {
    "three": "^0.186.1",
    "typescript": "^5.9.2"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.5"
  },
  "license": "MIT"
}
