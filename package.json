{
  "name": "fehm",
  "version": "1.0.0",
  "description": "Local-first codebase understanding, context engine and skill router for AI coding agents.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "fehm": "./dist/cli.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "skills",
    "assets/ontology",
    "THIRD_PARTY_NOTICES.md",
    "integrations",
    "SECURITY.md",
    "third_party/licenses"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "node --import tsx --test test/*.test.ts",
    "bench": "node --import tsx bench/run.ts",
    "start": "node dist/cli.js",
    "bench:skills": "node --import tsx bench/skills.ts",
    "prepack": "npm run build",
    "package:python": "npm run build && node scripts/package-python.mjs",
    "build:python": "npm run package:python && uv build --out-dir python-dist",
    "smoke": "python3 scripts/python-smoke.py",
    "vendor:review": "node scripts/vendor-review.mjs",
    "release:check": "npm run check && npm test && npm --prefix website run check && npm run build:python && npm run vendor:review && npm run smoke && npm run smoke:npm && python3 scripts/artifact-check.py",
    "smoke:npm": "node scripts/npm-smoke.mjs"
  },
  "engines": {
    "node": ">=22.13"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/amirhamzakhan2001/fehm.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "three": "^0.186.1",
    "typescript": "^5.9.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/three": "^0.186.0",
    "tsx": "^4.20.5"
  },
  "license": "MIT"
}
