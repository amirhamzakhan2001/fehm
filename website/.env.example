# Set these in the build environment. No .env loader or secrets are needed.
SITE_URL=https://fehm.pages.dev
SITE_INDEXABLE=false
# Leave empty until your Google Analytics property is configured.
GA_MEASUREMENT_ID=

# Optional Search Console HTML verification token (not a Google API key).
GOOGLE_SITE_VERIFICATION=

# Cloudflare Pages: skip automatic installation of the root Python package.
SKIP_DEPENDENCY_INSTALL=true
